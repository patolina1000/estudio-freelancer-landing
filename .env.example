# Copie este arquivo para ".env" e preencha os valores.

PORT=3000
# Endereço público do site (usado nas páginas de retorno da Stripe)
BASE_URL=http://localhost:3000

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Use as chaves de TESTE (sk_test_...) enquanto estiver desenvolvendo.
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...). Em desenvolvimento, vem do comando:
#   stripe listen --forward-to localhost:3000/webhook
STRIPE_WEBHOOK_SECRET=

# --- E-mail dos pedidos ---
# Para onde os pedidos pagos são enviados
OWNER_EMAIL=
# Servidor SMTP usado para enviar (Gmail, Resend, Brevo, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente que aparece no e-mail (opcional; padrão = SMTP_USER)
MAIL_FROM=
